def vlen(s):
    return len(ANSI.sub("", s))


def pad(s, w):
    return s + " " * max(0, w - vlen(s))


def box(title, rows, w, color=BLUE):
    top = "%s╭─ %s%s%s%s %s╮%s" % (color, R + B, title, R, color, "─" * (w - 5 - len(title)), R)
    body = ["%s│%s %s %s│%s" % (color, R, pad(r, w - 4), color, R) for r in rows]
    return [top] + body + ["%s╰%s╯%s" % (color, "─" * (w - 2), R)]


def side(a, b, wa, wb):
    n = max(len(a), len(b))
    a = a + [" " * wa] * (n - len(a))
    b = b + [" " * wb] * (n - len(b))
    return [x + " " + y for x, y in zip(a, b)]


def spark(vals, color=CYAN):
    lo, hi = min(vals), max(vals)
    return color + "".join("▁▂▃▄▅▆▇█"[int((v - lo) / (hi - lo + 1e-9) * 7)] for v in vals) + R


