def highlight(text, lang):
    if lang not in _HL:
        cm = "#" if lang in ("python", "hcl") else "//"
        kw = "|".join(KEYWORDS[lang].split())
        _HL[lang] = re.compile(
            "(?P<c>" + re.escape(cm) + ".*)"
            "|(?P<s>\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`[^`]*`)"
            "|(?P<n>\\b\\d+(?:\\.\\d+)?\\b)"
            "|(?P<k>\\b(?:" + kw + ")\\b)"
            "|(?P<f>\\b[A-Za-z_]\\w*(?=\\())")
    col = {"c": GREY, "s": GREEN, "n": ORANGE, "k": MAGENTA, "f": BLUE}
    return _HL[lang].sub(lambda m: col[m.lastgroup] + m.group() + R, text)


