def sc_traces():
    type_cmd("./bin/trace show --last --service gateway")
    total = ri(180, 900)
    names = [("auth", "verify_token"), ("orders", "list_orders"), ("postgres", "SELECT orders"), ("redis", "GET flags"),
             ("inventory", "lookup_sku"), ("billing", "price_quote"), ("search", "query_index"), ("gateway", "serialize")]
    palette = {"gateway": 75, "auth": 177, "orders": 114, "postgres": 215, "redis": 203, "inventory": 80, "billing": 221, "search": 171}
    spans = [("gateway", "GET /v2/orders", 0, total, 0)]

    def kids(start, dur, depth):
        if depth > 2 or dur < total * 0.06:
            return
        t = start + dur * random.uniform(0.02, 0.1)
        end = start + dur * 0.95
        for _ in range(ri(1, 3)):
            if t >= end - 4:
                break
            d = (end - t) * random.uniform(0.25, 0.7)
            svc, op = random.choice(names)
            spans.append((svc, op, t, d, depth))
            kids(t, d, depth + 1)
            t += d + dur * random.uniform(0.01, 0.05)

    kids(0, total, 1)
    tw = max(20, min(56, term_w() - 52))
    line("%sTrace %s   %d spans   %dms   %s%s" % (B, sha(16), len(spans), total, time.strftime("%H:%M:%S"), R))
    line("%s%-34s %s%s" % (DIM, "service / operation", "0ms" + " " * (tw - 3 - len("%dms" % total)) + "%dms" % total, R))
    for svc, op, st, d, depth in spans:
        off = int(st / total * tw)
        ln = max(1, int(d / total * tw))
        col = fg(palette[svc])
        label = ("  " * depth + svc + " " + DIM + op + R)
        line("%s %s%s%s%s %s%dms%s" % (pad(label, 34), " " * off, col, "█" * ln, R, DIM, d, R), 0.09)
    line()
    slow = max(spans[1:], key=lambda x: x[3])
    line("%sslowest span:%s %s %s (%dms, %d%% of trace)" % (YELLOW, R, slow[0], slow[1], slow[3], slow[3] * 100 // total))


