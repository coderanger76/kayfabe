def trivy_box(rows):
    heads = ["Library", "Vulnerability", "Severity", "Status", "Installed Version", "Fixed Version", "Title"]
    data = [[lib, cve, sev, "fixed", inst, fixed, title] for lib, cve, sev, inst, fixed, title in rows]
    w = [max([len(h)] + [len(r[i]) for r in data]) + 2 for i, h in enumerate(heads)]
    room = min(term_w(), 140) - (sum(w[:-1]) + len(w) + 1)  # keep the whole table inside the window
    w[-1] = max(14, min(w[-1], room))
    for r in data:
        r[-1] = r[-1] if len(r[-1]) <= w[-1] - 2 else r[-1][:w[-1] - 3] + "…"
    line("┌" + "┬".join("─" * x for x in w) + "┐", 0.02)
    line("│" + "│".join(h.center(w[i]) for i, h in enumerate(heads)) + "│", 0.02)
    line("├" + "┼".join("─" * x for x in w) + "┤", 0.02)
    for r in data:
        cells = []
        for i, c in enumerate(r):
            cell = (" " + c).ljust(w[i])
            cells.append(SEV[c] + cell + R if i == 2 else cell)
        line("│" + "│".join(cells) + "│", 0.05)
    line("└" + "┴".join("─" * x for x in w) + "┘", 0.02)


