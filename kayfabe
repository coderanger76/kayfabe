def sc_areachart():
    type_cmd("./bin/metrics --watch cpu,net --window 5m")
    _alt_on()
    w = max(30, min(term_w() - 9, 110))
    h1 = max(5, min(11, (term_h() - 8) * 2 // 3))
    h2 = max(3, min(6, term_h() - h1 - 8))
    cpu = [random.uniform(25, 60) for _ in range(w)]
    net = [random.uniform(20, 70) for _ in range(w)]
    blocks = " ▁▂▃▄▅▆▇█"

    def chart(vals, h, title, unit, base_col):
        rows = ["%s%s%s  %s%.0f%s%s" % (B, title, R, (base_col or GREEN) + B, vals[-1], unit, R)]
        for r in range(h - 1, -1, -1):
            lab = "%3d%%" % int(100 * (r + 1) / h) if r in (h - 1, h // 2) else "    "
            cells = ""
            for v in vals:
                n = max(0, min(8, int(v / 100 * h * 8) - r * 8))
                cells += (heat(r / h) if base_col is None else base_col) + blocks[n] + R if n else " "
            rows.append("%s%s%s │%s" % (GREY, lab, R, cells))
        rows.append("%s     └%s%s" % (GREY, "─" * w, R))
        return rows

    for _ in range(ri(45, 70)):
        cpu = (cpu + [max(3, min(98, cpu[-1] + random.uniform(-9, 9) + (14 if random.random() < 0.03 else 0)))])[-w:]
        net = (net + [max(3, min(98, net[-1] + random.uniform(-7, 7)))])[-w:]
        frame = ["%s METRICS %s %s  window 5m  host %s%s" % (INV + B, R, time.strftime("%H:%M:%S"), S.host, R)]
        frame += chart(cpu, h1, "CPU", "%", None) + chart(net, h2, "Net throughput", " MB/s", CYAN)
        out("\033[H" + "".join(l + "\033[K\n" for l in frame[:term_h() - 1]))
        nap(0.1, 0.18)
    _alt_off()


def sc_matrix():
    type_cmd("./scripts/verify-ledger-integrity.sh --deep")
    w, h = term_w(), term_h()
    _alt_on()
    chars = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉ0123456789ABCDEF"
    drops = [random.randint(-h, 0) if random.random() < 0.7 else None for _ in range(w)]
    speed = [random.choice([1, 1, 2]) for _ in range(w)]
    trail = [ri(6, h // 2 + 4) for _ in range(w)]
    frames = ri(55, 80)
    for f in range(frames):
        buf = []
        for x in range(w):
            y = drops[x]
            if y is None:
                if random.random() < 0.03 and f < frames - 25:
                    drops[x] = 0
                continue
            for s in range(speed[x]):
                yy = y + s
                if 1 <= yy <= h:
                    buf.append("\033[%d;%dH\033[97m%s" % (yy, x + 1, random.choice(chars)))
                if 1 <= yy - 1 <= h:
                    buf.append("\033[%d;%dH%s%s" % (yy - 1, x + 1, fg(random.choice([46, 40, 34])), random.choice(chars)))
                if 1 <= yy - trail[x] <= h:
                    buf.append("\033[%d;%dH " % (yy - trail[x], x + 1))
            drops[x] = y + speed[x]
            if drops[x] - trail[x] > h:
                drops[x] = None
        out("".join(buf) + R)
        nap(0.04, 0.06)
    top = max(1, h // 2 - 2)
    lft = max(1, (w - 34) // 2)
    out(R)
    for i, t in enumerate(["┌" + "─" * 32 + "┐", "│" + "✔ LEDGER INTEGRITY VERIFIED".center(32) + "│",
                           "│" + ("0 mismatches · %s blocks" % "{:,}".format(ri(4000, 9000))).center(32) + "│",
                           "└" + "─" * 32 + "┘"]):
        out("\033[%d;%dH%s%s%s" % (top + i, lft, B + GREEN, t, R))
    nap(2)
    _alt_off()


def sc_topology():
    type_cmd("./bin/netwatch --env production --live")
    _alt_on()
    tl = max(8, min(16, (term_w() - 50) // 3))
    lanes = [{"p": [], "n": 0, "ms": ri(8, 40)} for _ in range(3)]
    names = ["api-1", "api-2", "api-3"]
    for f in range(ri(60, 90)):
        frame = [" %s NETWATCH %s production  %s" % (INV + B, R, time.strftime("%H:%M:%S")), ""]
        for li, ln in enumerate(lanes):
            if random.random() < 0.35:
                ln["p"].append([0, 0])
            tracks = [[None] * tl for _ in range(3)]
            keep = []
            for t, pos in ln["p"]:
                pos += random.choice([1, 1, 2])
                if pos >= tl:
                    t, pos = t + 1, 0
                if t >= 3:
                    ln["n"] += 1
                    continue
                tracks[t][pos] = "●"
                keep.append([t, pos])
            ln["p"] = keep
            cols = [CYAN, YELLOW, GREEN]
            tr = ["".join((cols[i] + B + c + R) if c else (GREY + "─" + R) for c in tracks[i]) for i in range(3)]
            node = lambda s, c: sgr(c, 30) + " %s " % s + R
            frame.append("")
            frame[-1] = "  %s─%s─%s─%s─%s─%s─%s" % (node("client", 46), tr[0], node("lb", 45), tr[1], node(names[li], 43), tr[2], node("postgres", 42))
            frame.append("  %s%s req   avg %dms   %s%s" % (GREY, ln["n"] * 17, ln["ms"] + ri(-2, 2), bar(min(1, len(ln["p"]) / 6), 12), R))
            frame.append("")
        frame.append("%s  ● request in flight     %d rps     p99 %dms     errors 0.0%d%%%s" % (DIM, ri(900, 1400), ri(80, 190), ri(1, 4), R))
        out("\033[H" + "".join(l + "\033[K\n" for l in frame[:term_h() - 1]))
        nap(0.07, 0.11)
    _alt_off()


