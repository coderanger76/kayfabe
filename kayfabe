        for d in parts[:-1]:
            node = node.setdefault(d, {})
        node[parts[-1]] = None
    counts = [0, 0]

    def walk(node, prefix):
        items = sorted(node.items(), key=lambda kv: (kv[1] is None, kv[0]))
        for i, (name, sub) in enumerate(items):
            last = i == len(items) - 1
            if sub is None:
                counts[1] += 1
                line("%s%s%s" % (prefix, "└── " if last else "├── ", name), 0.03)
            else:
                counts[0] += 1
                line("%s%s%s%s%s" % (prefix, "└── " if last else "├── ", B + BLUE, name, R), 0.03)
                walk(sub, prefix + ("    " if last else "│   "))

    line(".")
    walk(tree, "")
    line()
    line("%d directories, %d files" % tuple(counts))


