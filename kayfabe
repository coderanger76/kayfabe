def sc_pytest(fail=None):
    if fail is None:
        fail = random.random() < 0.4
    type_cmd("pytest")
    files = random.sample(PYTEST_FILES, ri(4, len(PYTEST_FILES)))
    ns = [ri(10, 50) for _ in files]
    total = sum(ns)
    rule("test session starts", "")
    line("platform darwin -- Python 3.12.%d, pytest-8.%d.%d, pluggy-1.%d.0" % (ri(1, 7), ri(0, 3), ri(0, 2), ri(4, 5)))
    line("rootdir: /Users/%s/work/%s" % (S.user, S.proj))
    line("configfile: pyproject.toml")
    line("plugins: cov-5.0.0, asyncio-0.23.6, anyio-4.3.0, mock-3.14.0")
    line("collected %d items" % total)
    line()
    fail_file = random.randrange(len(files)) if fail else -1
    fail_at = ri(2, ns[fail_file]) if fail else -1
    done = 0
    for fi, (f, n) in enumerate(zip(files, ns)):
        out(f + " ")
        for i in range(n):
            if fi == fail_file and i == fail_at - 1:
                out(RED + "F" + R)
            elif random.random() < 0.02:
                out(YELLOW + "s" + R)
            else:
                out(GREEN + "." + R)
            nap(0.01, 0.06)
        done += n
        out(" " * max(1, 70 - (len(f) + 1 + n)) + "[%3d%%]\n" % (done * 100 // total))
    line()
    secs = random.uniform(3, 14)
    if fail:
        name, code, idx, errs, loc, exc = random.choice(PYTEST_FAILS)
        rule("FAILURES", "")
        rule(name, RED, "_")
        line()
        for i, c in enumerate(code):
            line((RED + ">" + R + c[1:]) if i == idx else c, 0.01)
        for e in errs:
            line("%sE       %s%s" % (RED, e, R), 0.01)
        line()
        line("%s%s: %s%s" % (RED, loc, exc, R))
        rule("short test summary info", "")
        line("%sFAILED%s %s::%s - %s" % (RED, R, loc.split(":")[0], name, errs[0].split(": ")[-1]))
        rule("1 failed, %d passed, %d skipped in %.2fs" % (total - 1 - 2, 2, secs), RED)
        S.queue.append(lambda: sc_fixup(sc_pytest))
    else:
        rule("%d passed, %d skipped, %d warnings in %.2fs" % (total - 2, 2, ri(0, 4), secs), GREEN)


