def sc_git_pull():
    type_cmd("git pull --rebase origin %s" % S.branch)
    n = ri(40, 320)
    line("remote: Enumerating objects: %d, done." % n)
    pct("remote: Counting objects", n)
    c = ri(15, n // 2 + 10)
    pct("remote: Compressing objects", c)
    t = ri(c // 2 + 5, c + 30)
    line("remote: Total %d (delta %d), reused %d (delta %d), pack-reused 0" % (
        t, ri(10, t), ri(0, t), ri(0, 30)))
    pct("Unpacking objects", t, ", %d.%d KiB | %d.%d MiB/s" % (ri(8, 400), ri(10, 99), ri(1, 9), ri(10, 99)))
    line("From github.com:%s/%s" % (S.org, S.proj))
    line(" * branch            %-10s -> FETCH_HEAD" % S.branch)
    line("   %s..%s  %s -> origin/%s" % (sha(), sha(), S.branch, S.branch))
    if random.random() < 0.5:
        line("Successfully rebased and updated refs/heads/%s." % S.branch)
    else:
        line("Updating %s..%s" % (sha(), sha()))
        line("Fast-forward")
        diffstat(random.sample(S.files, ri(2, min(6, len(S.files)))))


def sc_git_commit_push():
    files = random.sample(S.files, ri(2, min(5, len(S.files))))
    type_cmd("git status -s")
    for f in files:
        line(" %sM%s %s" % (RED, R, f), 0.03)
    type_cmd("git add -A")
    msg = commit_msg()
    type_cmd('git commit -m "%s"' % msg)
    line("[%s %s] %s" % (S.branch, sha(), msg))
    line(" %d files changed, %d insertions(+), %d deletions(-)" % (len(files), ri(5, 180), ri(1, 60)))
    S.dirty = False
    new = S.branch != "main" and random.random() < 0.6
    type_cmd("git push%s origin %s" % (" -u" if new else "", S.branch))
    n = ri(8, 30)
    line("Enumerating objects: %d, done." % n)
    pct("Counting objects", n)
    pct("Delta compression using up to 10 threads\rCompressing objects", n - 3)
    pct("Writing objects", n - 2, ", %d.%d KiB | %d.%d MiB/s" % (ri(1, 40), ri(10, 99), ri(1, 9), ri(10, 99)))
    line("Total %d (delta %d), reused 0 (delta 0), pack-reused 0" % (n - 2, ri(3, 12)))
    d = ri(3, 12)
    line("remote: Resolving deltas: 100%% (%d/%d), completed with %d local objects." % (d, d, ri(2, 8)))
    if new:
        line("remote: ")
        line("remote: Create a pull request for '%s' on GitHub by visiting:" % S.branch)
        line("remote:      https://github.com/%s/%s/pull/new/%s" % (S.org, S.proj, S.branch))
        line("remote: ")
    line("To github.com:%s/%s.git" % (S.org, S.proj))
    if new:
        line(" * [new branch]      %s -> %s" % (S.branch, S.branch))
        line("branch '%s' set up to track 'origin/%s'." % (S.branch, S.branch))
    else:
        line("   %s..%s  %s -> %s" % (sha(), sha(), S.branch, S.branch))


def sc_merge_conflict():
    f = random.choice(S.files)
    type_cmd("git merge origin/develop")
    line("Auto-merging %s" % random.choice(S.files))
    line("Auto-merging %s" % f)
    line("%sCONFLICT (content)%s: Merge conflict in %s" % (RED, R, f))
    line("Automatic merge failed; fix conflicts and then commit the result.")
    ans = ask("%s?%s Take upstream (theirs) for %s? %s[Y/n]%s " % (B + CYAN, R, f, DIM, R), "y")
    if ans.strip().lower().startswith("n"):
        line("Keeping local changes, will rebase hunks manually.")
    type_cmd("git checkout --theirs %s && git add %s" % (f, f))
    type_cmd("git commit --no-edit")
    line("[%s %s] Merge remote-tracking branch 'origin/develop' into %s" % (S.branch, sha(), S.branch))
    S.dirty = False


