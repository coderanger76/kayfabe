def diffstat(files):
    w = max(len(f) for f in files)
    ins = dele = 0
    for f in files:
        n = ri(2, 70)
        a = ri(0, n)
        b = n - a
        ins += a
        dele += b
        sa = max(1 if a else 0, round(a * 30 / 70))
        sb = max(1 if b else 0, round(b * 30 / 70))
        line(" %s | %3d %s%s%s%s%s" % (f.ljust(w), n, GREEN, "+" * sa, RED, "-" * sb, R), 0.03)
    line(" %d file%s changed, %d insertions(+), %d deletions(-)" % (
        len(files), "s" if len(files) > 1 else "", ins, dele))


