def _commit_push(msg):
    type_cmd('git commit -am "%s"' % msg)
    line("[%s %s] %s" % (S.branch, sha(), msg))
    line(" %d files changed, %d insertions(+), %d deletions(-)" % (ri(1, 3), ri(2, 40), ri(1, 15)))
    S.dirty = False
    type_cmd("git push origin %s" % S.branch)
    n = ri(5, 12)
    pct("Counting objects", n)
    pct("Writing objects", n - 2, ", %d.%d KiB | %d.%d MiB/s" % (ri(1, 9), ri(10, 99), ri(1, 9), ri(10, 99)))
    line("To github.com:%s/%s.git" % (S.org, S.proj))
    line("   %s..%s  %s -> %s" % (sha(), sha(), S.branch, S.branch))


def arc_incident():
    svc = random.choice(SERVICES)
    ns = "production"
    key, err, what, msg = random.choice(CAUSES)
    f = random.choice([x for x in S.files if not x.endswith((".json", ".toml", "go.mod", ".yaml", ".yml", ".tf"))] or S.files)

    def logs():
        type_cmd("kubectl logs deploy/%s -n %s --previous --tail=8" % (svc, ns))
        for m in ["INFO  starting %s v1.%d.%d" % (svc, ri(2, 9), ri(0, 9)), "INFO  loading config from /etc/config/app.yaml", "WARN  feature flag service slow (%dms)" % ri(1500, 3000), err, "FATAL exiting with code 1"]:
            line("%s %s" % (now_utc(), m), 0.12)

    def find():
        word = {"pool": "pool.acquire", "nil": "session.", "oom": "fetchAll", "cfg": "queue.brokers"}[key]
        type_cmd('grep -rn "%s" . --include="*" -l | head -5' % word)
        for x in random.sample(S.files, min(3, len(S.files))):
            line("./%s" % x, 0.05)
        line("./%s" % f)

    def roll():
        type_cmd("kubectl rollout status deploy/%s -n %s" % (svc, ns))
        for i in range(1, 4):
            nap(0.8, 1.6)
            line('Waiting for deployment "%s" rollout to finish: %d out of 3 new replicas have been updated...' % (svc, i))
        nap(1)
        line('deployment "%s" successfully rolled out' % svc)

    def health():
        type_cmd("curl -s https://api.%s/healthz | jq" % S.domain)
        line("{")
        line('  "status": "ok",')
        line('  "version": "1.%d.%d",' % (ri(2, 9), ri(0, 9)))
        line('  "db": "up", "cache": "up", "queue": "up"')
        line("}")

    return [lambda: _kubectl_pods(svc, ns, True), logs, find, lambda: sc_editor(f), lambda: _commit_push(msg % svc if "%s" in msg else msg),
            sc_gh_run, roll, lambda: _kubectl_pods(svc, ns, False), health]


