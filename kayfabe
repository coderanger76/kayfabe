def sc_dashboard():
    type_cmd("./bin/ops-dash --env production --refresh 1s")
    h, w = term_h(), min(term_w(), 120)
    cw = (w - 1) // 2
    cw2 = w - 1 - cw
    out("\033[?1049h\033[2J")
    S.alt = True
    n = max(10, cw - 6)
    hist = [ri(400, 900) for _ in range(n)]
    lat = [random.uniform(18, 40), random.uniform(70, 140), random.uniform(180, 400)]
    svcs = random.sample(SERVICES, 5)
    cpu = {s: random.uniform(10, 70) for s in svcs}
    stages = ["lint", "unit", "build", "push", "migrate", "deploy", "smoke"]
    prog = 0.0
    logs = []
    msgs = ["GET /v2/orders 200 %dms", "POST /v2/sessions 201 %dms", "cache hit flags:%s",
            "batch flushed records=%d", "WARN slow query %dms ledger_entries", "GET /v2/health 200 %dms"]
    log_n = max(2, min(8, h - 1 - 6 - 9 - 2 - 1))
    for _ in range(ri(32, 48)):
        hist = (hist + [max(150, min(1500, hist[-1] + ri(-140, 150)))])[-n:]
        for i in range(3):
            lat[i] = max(5, lat[i] + random.uniform(-8, 8) * (i + 1))
        for s in svcs:
            cpu[s] = max(2, min(98, cpu[s] + random.uniform(-9, 9)))
        prog += 0.03
        if prog > 1.25:
            prog = 0.0
        m = random.choice(msgs)
        logs.append("%s%s%s %s" % (GREY, now_utc()[11:23], R, (m % sha(5)) if "flags" in m else (m % ri(3, 450))))
        logs = logs[-log_n:]
        d = hist[-1] - hist[-2]
        tp = box("Throughput", ["%s%d%s req/s  %s%s %d%s" % (B, hist[-1], R, GREEN if d >= 0 else RED, "▲" if d >= 0 else "▼", abs(d), R),
                               spark(hist), "%sp-err %.2f%%   conns %d%s" % (DIM, random.uniform(0.01, 0.4), ri(900, 1200), R),
                               "%smin %d  max %d  avg %d%s" % (DIM, min(hist), max(hist), sum(hist) // len(hist), R)], cw, CYAN)
        lt = box("Latency", ["%s %s%s %5.0f ms" % (nm, heat(v / 400), bar(v / 400, 20), v) + R
                            for nm, v in zip(["p50", "p95", "p99"], lat)] + [""], cw2, MAGENTA)
        sv = box("Services", ["%s●%s %-10s %s%s%s %3.0f%%  %4dM" % (heat(cpu[s] / 100), R, s, heat(cpu[s] / 100), bar(cpu[s] / 100, 12), R, cpu[s], ri(200, 900)) for s in svcs], cw, GREEN)
        cur = min(len(stages) - 1, int(prog * len(stages)))
        pr = []
        for i, st in enumerate(stages):
            if prog >= 1.0 or i < cur:
                pr.append("%s✔%s %s" % (GREEN, R, st))
            elif i == cur:
                pr.append("%s%s%s %s%s%s %s" % (CYAN, SPIN[ri(0, 9)], R, B, st, R, CYAN + bar((prog * len(stages)) % 1, 10) + R))
            else:
                pr.append("%s○ %s%s" % (GREY, st, R))
        pl = box("Pipeline", pr, cw2, YELLOW)
        lg = box("Live log", logs, w, BLUE)
        head = "%s OPS-DASH %s production  %s  %srefresh 1s%s" % (INV + B, R, time.strftime("%H:%M:%S"), DIM, R)
        frame = [head] + side(tp, lt, cw, cw2) + side(sv, pl, cw, cw2) + lg
        out("\033[H" + "".join(l + "\033[K\n" for l in frame[:h - 1]))
        nap(0.22, 0.4)
    out("\033[?1049l")
    S.alt = False


def sc_docker_pull():
    img = random.choice(["postgres:16", "redis:7-alpine", "nginx:1.27", "grafana/grafana:11.0", "node:20-alpine", "prom/prometheus:v2.52"])
    type_cmd("docker pull %s" % img)
    line("%s: Pulling from %s" % (img.split(":")[1], img.split(":")[0] if "/" in img else "library/" + img.split(":")[0]))
    n = ri(5, 8)
    ids = [sha(12) for _ in range(n)]
    size = [random.uniform(2, 70) for _ in range(n)]
    prog = [0.0] * n
    stage = [0] * n
    first = True
    while any(st < 3 for st in stage):
        active = [i for i in range(n) if 0 < stage[i] < 3]
        for i in range(n):
            if stage[i] == 0 and len(active) < 3 and random.random() < 0.5:
                stage[i] = 1
                active.append(i)
        buf = "" if first else "\033[%dA" % n
        for i in range(n):
            if stage[i] == 1:
                prog[i] += random.uniform(0.08, 0.3)
                if prog[i] >= 1:
                    prog[i], stage[i] = 0.0, 2
            elif stage[i] == 2:
                prog[i] += random.uniform(0.15, 0.4)
                if prog[i] >= 1:
                    stage[i] = 3
            if stage[i] == 0:
                st = "%sWaiting%s" % (GREY, R)
            elif stage[i] == 1:
                k = int(prog[i] * 30)
                st = "Downloading [%s>%s]  %5.1fMB/%.1fMB" % ("=" * k, " " * (29 - k), prog[i] * size[i], size[i])
            elif stage[i] == 2:
                k = int(prog[i] * 30)
                st = "Extracting [%s>%s]  %.1fMB/%.1fMB" % ("=" * k, " " * (29 - k), prog[i] * size[i], size[i])
            else:
                st = "%sPull complete%s" % (GREEN, R)
            buf += "%s: %s\033[K\n" % (ids[i], st)
        out(buf)
        first = False
        nap(0.07, 0.14)
    line("Digest: sha256:%s" % sha(64))
    line("Status: Downloaded newer image for %s" % img)
    line("docker.io/%s%s" % ("" if "/" in img else "library/", img))


def sc_gh_run():
    type_cmd("gh run watch")
    jobs = ["lint", "typecheck", "unit (ubuntu-latest, 20)", "unit (macos-latest, 20)", "integration",
            "build", "docker-publish", "deploy-staging"]
    dur = [ri(12, 90) for _ in jobs]
    start = [0, 0, 0, 0, ri(20, 40), ri(40, 70), ri(70, 100), ri(100, 130)]
    wid = ri(9000000000, 9999999999)
    line("%s*%s %s CI · %d" % (YELLOW, R, S.branch, wid))
    line("Triggered via push about 1 minute ago")
    line()
    line("%sJOBS%s" % (B, R))
    t = 0
    first = True
    n = len(jobs)
    while True:
        buf = "" if first else "\033[%dA" % n
        done = 0
        for i, j in enumerate(jobs):
            if t >= start[i] + dur[i]:
                buf += "%s✓%s %s in %ds %s(ID %d)%s\033[K\n" % (GREEN, R, j, dur[i], GREY, wid * 10 + i, R)
                done += 1
            elif t >= start[i]:
                buf += "%s%s%s %s %s(ID %d)%s\033[K\n" % (YELLOW, SPIN[(t // 2 + i) % 10], R, j, GREY, wid * 10 + i, R)
            else:
                buf += "%s*%s %s\033[K\n" % (GREY, R, j)
        out(buf)
        first = False
        if done == n:
            break
        t += 3
        nap(0.12, 0.2)
    line()
    line("%s✓%s Run CI (%d) completed with 'success'" % (GREEN, R, wid))


def sc_flame():
    type_cmd("./bin/profile --pid %d --duration 10s --ascii" % ri(1000, 60000))
    line("Sampling at 99 Hz... %sdone%s" % (GREEN, R))
    line("%sSamples: %d   Duration: 10.0s   Threads: %d%s" % (DIM, ri(8000, 12000), ri(4, 16), R))
    line()
    names = ["main", "handle_request", "db.query", "serialize_json", "auth.verify", "cache.get", "render_template",
             "pool.acquire", "http.write", "parse_body", "ledger.reconcile", "batch.flush", "tls.handshake", "gc.collect"]
    heat_cols = [RED, RED, ORANGE, ORANGE, YELLOW, YELLOW, GREEN]
    rows = []

    def walk(name, p, depth):
        rows.append((name, p, depth))
        if depth < 4 and p > 6:
            rest = p * random.uniform(0.7, 0.97)
            for _ in range(ri(1, 3)):
                share = rest * random.uniform(0.35, 0.8)
                rest -= share
                if share > 3:
                    walk(random.choice(names), share, depth + 1)

    walk("main", 100.0, 0)
    for name, p, d in rows:
        cells = p / 100 * 46
        full = int(cells)
        part = "▏▎▍▌▋▊▉"[int((cells - full) * 7)] if cells - full > 0.15 else ""
        line("%s%-26s%s%s%s%s %s%5.1f%%%s" % ("  " * d, name, "", heat_cols[min(d, 6)], "█" * full + part, R, DIM, p, R), 0.04)


