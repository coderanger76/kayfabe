def sc_docker_pull():
    img = random.choice(["postgres:16", "redis:7-alpine", "nginx:1.27", "grafana/grafana:11.0", "node:20-alpine", "prom/prometheus:v2.52"])
    type_cmd("docker pull %s" % img)
    line("%s: Pulling from %s" % (img.split(":")[1], img.split(":")[0] if "/" in img else "library/" + img.split(":")[0]))
    n = ri(5, 8)
    ids = [sha(12) for _ in range(n)]
    size = [random.uniform(2, 70) for _ in range(n)]
    prog = [0.0] * n
    stage = [0] * n
    first = True
    while any(st < 3 for st in stage):
        active = [i for i in range(n) if 0 < stage[i] < 3]
        for i in range(n):
            if stage[i] == 0 and len(active) < 3 and random.random() < 0.5:
                stage[i] = 1
                active.append(i)
        buf = "" if first else "\033[%dA" % n
        for i in range(n):
            if stage[i] == 1:
                prog[i] += random.uniform(0.08, 0.3)
                if prog[i] >= 1:
                    prog[i], stage[i] = 0.0, 2
            elif stage[i] == 2:
                prog[i] += random.uniform(0.15, 0.4)
                if prog[i] >= 1:
                    stage[i] = 3
            if stage[i] == 0:
                st = "%sWaiting%s" % (GREY, R)
            elif stage[i] == 1:
                k = int(prog[i] * 30)
                st = "Downloading [%s>%s]  %5.1fMB/%.1fMB" % ("=" * k, " " * (29 - k), prog[i] * size[i], size[i])
            elif stage[i] == 2:
                k = int(prog[i] * 30)
                st = "Extracting [%s>%s]  %.1fMB/%.1fMB" % ("=" * k, " " * (29 - k), prog[i] * size[i], size[i])
            else:
                st = "%sPull complete%s" % (GREEN, R)
            buf += "%s: %s\033[K\n" % (ids[i], st)
        out(buf)
        first = False
        nap(0.07, 0.14)
    line("Digest: sha256:%s" % sha(64))
    line("Status: Downloaded newer image for %s" % img)
    line("docker.io/%s%s" % ("" if "/" in img else "library/", img))


