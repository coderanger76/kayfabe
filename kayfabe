# ---------------------------------------------------------------- plumbing

SPEED = 1.0
ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def sgr(*c):
    return "\033[" + ";".join(str(x) for x in c) + "m"


def fg(n):
    return "\033[38;5;%dm" % n


R, B, DIM, INV = sgr(0), sgr(1), sgr(2), sgr(7)
RED, GREEN, YELLOW, BLUE = fg(203), fg(114), fg(221), fg(75)
MAGENTA, CYAN, ORANGE, GREY = fg(177), fg(80), fg(215), fg(244)


class State:
    pass


S = State()
S.user = getpass.getuser()
S.host = socket.gethostname().split(".")[0]
S.queue = []
S.recent = []
