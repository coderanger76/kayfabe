def banner(text):
    width = sum(len(FONT[c][0]) + 1 for c in text)
    if width > term_w() - 2:
        return
    line()
    for r in range(5):
        row = ""
        x = 0
        for ch in text:
            for cell in FONT[ch][r]:
                row += (gradient(x, width) + cell + R) if cell != " " else " "
                x += 1
            row += " "
            x += 1
        line("  " + row, 0.07)
    line()


