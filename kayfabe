def _dig_head(q, status="NOERROR", ans=1, auth=0, flags="qr rd ra", extra=0):
    line("; <<>> DiG 9.10.6 <<>> %s" % q)
    line(";; global options: +cmd")
    line(";; Got answer:")
    line(";; ->>HEADER<<- opcode: QUERY, status: %s, id: %d" % (status, ri(1000, 65000)))
    line(";; flags: %s; QUERY: 1, ANSWER: %d, AUTHORITY: %d, ADDITIONAL: %d" % (flags, ans, auth, 1 + extra))
    line()
    line(";; OPT PSEUDOSECTION:")
    line("; EDNS: version: 0, flags:; udp: 1232")


def _dig_foot(server="192.168.1.1"):
    line()
    line(";; Query time: %d msec" % ri(3, 60))
    line(";; SERVER: %s#53(%s)" % (server, server))
    line(";; WHEN: %s" % time.strftime("%a %b %d %H:%M:%S %Z %Y"))
    line(";; MSG SIZE  rcvd: %d" % ri(60, 400))
    line()


