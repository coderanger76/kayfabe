S.dirty = True
S.remote = None
S.tty = sys.stdin.isatty() and sys.stdout.isatty()
S.saved_tty = None


def out(s):
    sys.stdout.write(s)
    sys.stdout.flush()


def nap(a, b=None):
    t = a if b is None else random.uniform(a, b)
    time.sleep(t / SPEED)


def ri(a, b):
    return random.randint(a, max(a, b))


def sha(n=7):
    return "".join(random.choices("0123456789abcdef", k=n))


def term_w():
    return shutil.get_terminal_size((100, 30)).columns


def term_h():
    return shutil.get_terminal_size((100, 30)).lines


def now_utc():
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()) + ".%03dZ" % ri(0, 999)


def line(s="", d=0.02):
    out(s + "\n")
    nap(d * 0.6, d * 1.6)


def bar(frac, w=30, full="█", empty="░"):
    n = int(max(0.0, min(1.0, frac)) * w)
    return full * n + empty * (w - n)


def rule(text, color, ch="="):
    w = min(term_w(), 100)
    t = " %s " % text if text else ""
    left = (w - len(t)) // 2
    line("%s%s%s%s%s" % (color, ch * left, t, ch * (w - left - len(t)), R), 0.01)


def spin(label_fn, secs, color=CYAN):
    t0 = time.time()
    i = 0
    while (time.time() - t0) * SPEED < secs:
        out("\r%s%s%s %s\033[K" % (color, SPIN[i % len(SPIN)], R, label_fn()))
        i += 1
        time.sleep(0.08 / SPEED)
    out("\r\033[K")


def pct(label, total, tail=""):
    """git-style 'label: 42% (12/30)' counter that ends with ', done.'"""
    steps = ri(5, 12)
    for i in range(1, steps):
        out("\r%s: %3d%% (%d/%d)" % (label, i * 100 // steps, total * i // steps, total))
        nap(0.04, 0.18)
    out("\r%s: 100%% (%d/%d)%s, done.\n" % (label, total, total, tail))
    nap(0.05)


def progress(label, secs, w=28):
    steps = ri(12, 24)
    for i in range(steps + 1):
        f = i / steps
        out("\r%s %s%s%s %3d%%\033[K" % (label, GREEN, bar(f, w), R, int(f * 100)))
        nap(secs / steps * 0.5, secs / steps * 1.5)
    out("\n")


# -------------------------------------------------------------- typing

def _type_plain(t, base):
    for ch in t:
        out(ch)
        if ch == " ":
            d = random.uniform(0.01, 0.05)
        else:
            d = random.uniform(base * 0.3, base * 1.8)
        if random.random() < 0.03:
            d += random.uniform(0.1, 0.35)
        time.sleep(d / SPEED)


def type_text(s, base=0.045):
    pos = 0
    for m in ANSI.finditer(s):
        _type_plain(s[pos:m.start()], base)
        out(m.group())
        pos = m.end()
    _type_plain(s[pos:], base)


def prompt():
    if S.remote:
        return S.remote
    dirty = YELLOW + "✗" + R + " " if S.dirty else ""
    return "%s➜%s  %s%s%s %s%sgit:(%s%s%s)%s %s" % (
        GREEN, R, B, CYAN, S.proj, R + B, BLUE, RED, S.branch, BLUE, R, dirty)


def type_cmd(cmd, pr=None):
    out(prompt() if pr is None else pr)
    nap(0.3, 1.2)
    if len(cmd) > 10 and random.random() < 0.07:
        p = ri(4, len(cmd) - 3)
        type_text(cmd[:p] + random.choice("qwertyuiopasdf"))
        nap(0.3, 0.7)
        out("\b \b")
        nap(0.1, 0.3)
        type_text(cmd[p:])
    else:
        type_text(cmd)
    nap(0.15, 0.5)
    out("\n")


# ---------------------------------------------------- the user interrupts

def set_echo(on):
    if not (S.tty and termios):
        return
    try:
        a = termios.tcgetattr(0)
        if on:
            a[3] |= termios.ECHO
        else:
            a[3] &= ~termios.ECHO
        termios.tcsetattr(0, termios.TCSADRAIN, a)
    except Exception:
        pass


def ask(text, auto="y", secret=False, wait=(4.0, 8.0)):
    """Print a prompt and give the human a few beats to answer. If they stay
    silent, 'type' the auto answer ourselves and carry on. Input is discarded."""
    out(text)
    t = random.uniform(*wait)
    ans = None
    if S.tty:
        try:
            termios.tcflush(0, termios.TCIFLUSH)
        except Exception:
            pass
        set_echo(not secret)
        try:
            ready, _, _ = select.select([sys.stdin], [], [], t / SPEED)
            if ready:
                ans = sys.stdin.readline()
        except (EOFError, ValueError, OSError):
            ans = ""
        set_echo(False)
        try:
            termios.tcflush(0, termios.TCIFLUSH)
        except Exception:
            pass
        if ans is not None and not secret and not ans.endswith("\n"):
            out("\n")
    else:
        nap(t)
    if ans is None:  # nobody answered
        if secret:
            nap(0.8, 1.8)
        else:
            type_text(auto)
            nap(0.2, 0.6)
        out("\n")
        ans = auto
    nap(0.3, 0.8)
    return ans


def cleanup():
    if S.alt:
        out("\033[?1049l")
        S.alt = False
    out("\033[?25h" + R)
    if S.saved_tty and termios:
        try:
            termios.tcsetattr(0, termios.TCSADRAIN, S.saved_tty)
        except Exception:
            pass


