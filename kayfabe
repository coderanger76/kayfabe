    for f in range(ri(10, 16)):
        total += ri(500, 4000)
        base = [b + ri(0, 400) for b in base]
        hours[-1] = max(5, hours[-1] + ri(-6, 12))
        mx = max(base)
        rows = ["%s%-18s%s %s%s%s %6d" % (CYAN, p, R, GREEN, bar(b / mx, 14), R, b) for p, b in sorted(zip(paths, base), key=lambda x: -x[1])[:6]]
        stat = ["%s%-4s%s %s%s%s %5.1f%%" % (c_, k, R, c_, bar(v, 16), R, v * 100) for (k, v), c_ in zip(codes.items(), [GREEN, BLUE, YELLOW, RED])]
        hmx = max(hours)
        hr = [GREEN + "".join(" ▁▂▃▄▅▆▇█"[int(v / hmx * 8)] for v in hours) + R, "%s0h%s%s12h%s%s24h%s" % (DIM, R, " " * 9, DIM + R, " " * 8, DIM)]
        head = ["%sTotal Requests%s %-9d   %sValid%s %-9d   %sUnique Visitors%s %-7d   %sBandwidth%s %.2f GiB" % (B, R, total, B, R, total - ri(0, 90), B, R, total // ri(8, 14), B, R, total * 0.00002)]
        frame = [" %s GOACCESS %s %s" % (INV + B, R, time.strftime("%H:%M:%S"))] + head + [""]
        frame += side(box("Requested Files", rows, cw, CYAN), box("HTTP Status Codes", stat, cw2, YELLOW), cw, cw2)
        frame += side(box("Hourly Traffic", hr, cw, GREEN), box("Top Browsers", ["%-14s %s%s%s" % (n, MAGENTA, bar(v, 16), R) for n, v in [("Chrome", .58), ("Safari", .27), ("Firefox", .09), ("curl", .06)]], cw2, MAGENTA), cw, cw2)
