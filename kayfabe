def _kubectl_pods(svc, ns, bad):
    type_cmd("kubectl get pods -n %s -l app=%s" % (ns, svc))
    line("%-44s %-7s %-18s %-9s %s" % ("NAME", "READY", "STATUS", "RESTARTS", "AGE"), 0.03)
    for i in range(3):
        p = "%s-%s-%s" % (svc, sha(9), "".join(random.choices("bcdfghjklmnpqrstvwxz2456789", k=5)))
        if bad and i == 0:
            line("%s%-44s %-7s %-18s %-9s %s%s" % (RED, p, "0/1", "CrashLoopBackOff", "%d (1m ago)" % ri(4, 9), "%dm" % ri(8, 40), R), 0.05)
        else:
            line("%-44s %-7s %s%-18s%s %-9s %s" % (p, "1/1", GREEN, "Running", R, "0" if not bad else ri(0, 1), "%dm" % ri(1, 59) if not bad else "%dd%dh" % (ri(0, 9), ri(0, 23))), 0.05)


CAUSES = [
    ("pool", "ERROR failed to acquire database connection: timeout after 5000ms (pool exhausted: 20/20 in use)", "connection pool", "fix(db): release connection on early return in %s"),
    ("nil", "FATAL panic: runtime error: invalid memory address or nil pointer dereference", "nil deref", "fix(%s): guard nil session before token refresh"),
    ("oom", "ERROR container exceeded memory limit (512Mi) - OOMKilled (exit code 137)", "memory limit", "fix(%s): stream batch instead of loading all rows"),
