def arc_lockout():
    f, l, s = person()
    dc = random.choice(["DC01", "DC02"])
    fqdn = "%s.%s" % (dc.lower(), ad_domain())
    src = "WS-%s" % "".join(random.choices("ABCDEFGHJKLMNPQRSTUVWXYZ23456789", k=6))

    def enter():
        type_cmd("Enter-PSSession -ComputerName %s -Credential CORP\\svc-admin" % fqdn)
        line("PowerShell credential request")
        ask("Password for user CORP\\svc-admin: ", secret=True, wait=(4.0, 7.0))
        S.remote = "[%s]: PS C:\\Users\\svc-admin\\Documents> " % fqdn
        S.rtitle = "pwsh"

    def lookup():
        type_cmd("Get-ADUser -Identity %s -Properties LockedOut,BadLogonCount,LastBadPasswordAttempt,PasswordLastSet | Format-List" % s)
        nap(0.8, 1.4)
        ps_list([("BadLogonCount", str(ri(5, 12))), ("DistinguishedName", "CN=%s %s,OU=Users,OU=HQ,%s" % (f, l, dn_base())), ("LastBadPasswordAttempt", when(0)),
                 ("LockedOut", RED + "True" + R), ("PasswordLastSet", when(ri(60, 120))), ("SamAccountName", s)], 22)
        line()

    def source():
        type_cmd("Get-WinEvent -FilterHashtable @{LogName='Security';Id=4740} -MaxEvents 3 | Where-Object { $_.Message -match '%s' } | Select TimeCreated,Message" % s)
        nap(1, 1.8)
        ps_table(["TimeCreated", "Message"], [[when(0), "A user account was locked out. Caller Computer Name: %s" % src] for _ in range(2)])

    def unlock():
        type_cmd("Unlock-ADAccount -Identity %s" % s)
        nap(0.6, 1.2)
        type_cmd("Get-ADUser %s -Properties LockedOut | Select-Object SamAccountName,LockedOut" % s)
        ps_table(["SamAccountName", "LockedOut"], [[s, "False"]])

    def leave():
        type_cmd("Exit-PSSession")
        S.remote = None
        S.rtitle = None
        type_cmd("ping -c 3 %s.%s" % (src.lower(), ad_domain()))
        ip = pip4(ri(10, 40))
        line("PING %s.%s (%s): 56 data bytes" % (src.lower(), ad_domain(), ip))
        for i in range(3):
            line("64 bytes from %s: icmp_seq=%d ttl=127 time=%.3f ms" % (ip, i, random.uniform(0.8, 6)), 0.5)

    return [enter, lookup, source, unlock, leave]


