def pick(table):
    boost = ROLE_BOOST.get(S.role, ())
    ok = [(f, w * (3 if getattr(f, "__name__", "") in boost else 1)) for f, w, st in table
          if (st is None or S.stack in st) and getattr(f, "__name__", "") + str(id(f)) not in S.recent]
    fns, ws = zip(*ok)
    f = random.choices(fns, ws)[0]
    S.recent = (S.recent + [getattr(f, "__name__", "") + str(id(f))])[-8:]
    return f


def main():
    global SPEED
    ap = argparse.ArgumentParser(description="Look busy. Everything is fake and harmless.")
    ap.add_argument("--speed", type=float, default=1.0, help="2 = twice as fast, 0.5 = slower")
    ap.add_argument("--seed", type=int, help="repeatable randomness")
    ap.add_argument("--role", choices=["all", "dev", "it", "data", "sec", "ops"], default="all",
                    help="what kind of work to look like doing (default: a bit of everything)")
    args = ap.parse_args()
    S.role = args.role
    if args.role != "all":
        PROJECTS[:] = [p for p in PROJECTS if p[1] in ROLES[args.role]]
    if hasattr(signal, "SIGWINCH"):
        signal.signal(signal.SIGWINCH, _on_winch)
    SPEED = max(0.05, args.speed)
    if args.seed is not None:
        random.seed(args.seed)

    if S.tty and termios:
        S.saved_tty = termios.tcgetattr(0)
    atexit.register(cleanup)
    set_echo(False)
    out("\033[2J\033[H")
    S.proj, S.branch = "~", "main"
    S.dirty = False
    sc_fetch()
    switch_project(first=True)
    count = 0
    until_ask = ri(3, 5)
    mood = 1.0
    try:
        while True:
            if count % ri(4, 8) == 0:
                mood = random.choice([0.4, 0.7, 1.0, 1.0, 1.5, 2.5])  # bursts and lulls
            nap(0.3 * mood, 1.1 * mood)
            if S.queue:
                S.queue.pop(0)()
            elif until_ask <= 0:
                pick(INTERACTIVE)()
                until_ask = ri(3, 6)
            elif count and count % ri(7, 11) == 0:
                switch_project()
            else:
                pick(SCENARIOS)()
            count += 1
            until_ask -= 1
    except KeyboardInterrupt:
        out("\n")
    except BrokenPipeError:
        pass


