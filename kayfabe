        vals.append(max(0.001, start * (end / start) ** (f ** 0.7) + random.uniform(-noise, noise) * start * (1 - f)))
    return vals


def sc_train(diverge=False, ds=None):
    ds = ds or random.choice(DATASETS)
    model = random.choice(MODELS)
    n = ri(8, 12)
    type_cmd("python -m trainer.fit --config configs/%s.yaml --epochs %d" % (ds, n))
    nap(0.5, 1.2)
    line("Seed set to 42")
    line("Using MPS device (Apple Silicon); precision 16-mixed")
    line("Loading s3://%s-ml-data/%s/v%d/train.parquet  (%s rows)" % (S.org, ds, ri(2, 9), "{:,}".format(ri(200000, 4800000))))
    line("%s%-24s%s %s" % (B, "Name", R, "Params"))
    for nm, p in [("encoder", ri(200, 9000)), ("head", ri(20, 400))]:
        line("%-24s %.1f K" % (nm, p / 10.0))
    line("Trainable params: %.1f M  |  model: %s" % (random.uniform(0.2, 24), model))
    tl = _curve(n, random.uniform(0.9, 1.4), random.uniform(0.08, 0.25))
    vl = [t * random.uniform(1.02, 1.18) for t in tl]
    acc = [min(0.995, 1 - v * 0.55) for v in vl]
    fail_at = ri(3, n - 2) if diverge else -1
    for e in range(n):
        steps = ri(120, 640)
        for k in range(0, steps + 1, max(1, steps // 14)):
            f = k / steps
            out("\rEpoch %d/%d %s%s%s %d/%d  %sloss=%.3f%s" % (e + 1, n, GREEN, bar(f, 26), R, k, steps, GREY, tl[e] * (1.4 - 0.4 * f), R))
            nap(0.03, 0.09)
        if e == fail_at:
            out("\rEpoch %d/%d %s%s%s %d/%d  %sloss=nan%s\033[K\n" % (e + 1, n, RED, bar(0.4, 26), R, steps // 3, steps, RED, R))
            line("%sRuntimeError: Function 'MseLossBackward0' returned nan values in its 0th output.%s" % (RED, R))
            line("%sTrainer was signaled to stop: non-finite loss detected (val_loss=nan)%s" % (RED, R))
            return fail_at
        out("\rEpoch %d/%d %s%s%s %d/%d  %sloss=%.3f val_loss=%.3f val_acc=%.4f%s\033[K\n" % (
            e + 1, n, GREEN, bar(1, 26), R, steps, steps, CYAN, tl[e], vl[e], acc[e], R))
    line()
    line("%s%-10s%s %s" % (B, "train loss", R, spark(tl, GREEN)))
    line("%s%-10s%s %s" % (B, "val loss", R, spark(vl, YELLOW)))
    line("%s%-10s%s %s" % (B, "val acc", R, spark(acc, CYAN)))
    best = vl.index(min(vl))
    line("Best epoch: %d  val_loss=%.4f  val_acc=%.4f  auc=%.4f" % (best + 1, vl[best], acc[best], random.uniform(0.9, 0.985)))
    line("Saved checkpoint -> artifacts/%s-%s.ckpt (%.1f MB)" % (ds, sha(6), random.uniform(8, 190)))
    return -1


